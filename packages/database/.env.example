# PostgreSQL connection string with schema scope for Supabase Connection Pooling
# Format: postgresql://user:password@host:port/database?schema=tenant_schema&sslmode=require
# Replace {project_id}, {password}, and {schema} with your Supabase credentials
DATABASE_URL="postgresql://postgres.{project_id}:{password}@aws-0-{region}.pooler.supabase.com:6543/postgres?schema=public&sslmode=require"

# Direct connection URL (not pooled) for migrations and schema introspection
# This uses the direct connection endpoint from Supabase
DIRECT_URL="postgresql://postgres.{project_id}:{password}@aws-0-{region}.databases.supabase.co:5432/postgres?schema=public&sslmode=require"

# Optional: Custom connection string for per-tenant schema
# Format allows multiple tenant schemas in one database
# DATABASE_URL="postgresql://postgres.{project_id}:{password}@aws-0-{region}.pooler.supabase.com:6543/postgres?schema=tenant_acme_clinic&sslmode=require"
